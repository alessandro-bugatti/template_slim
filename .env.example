# Copia questo file in .env e compila i valori.
# Non committare mai il file .env nel repository.

# ------------------------------------------------------------
# Nome progetto
# Usato come prefisso per i container Docker.
# Scegli un nome breve, senza spazi (es: biblioteca, gestionale)
# ------------------------------------------------------------
PROJECT_NAME=mio-progetto

# ------------------------------------------------------------
# Porte esposte sull'host
# Se hai più progetti attivi contemporaneamente, usa porte diverse
# per ogni progetto (es: 9081, 9082, ... per PORT_HTTP)
# ------------------------------------------------------------
PORT_HTTP=9080
PORT_HTTPS=9443
PORT_DB=3306
PORT_ADMINER=8080

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
MYSQL_HOST=database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=nome_database
MYSQL_USER=utente_db
MYSQL_PASSWORD=password_db

# ------------------------------------------------------------
# Applicazione
# ------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_USE_CUSTOM_ERROR_HANDLER=false

# Path applicativi
TEMPLATE_DIR=templates
IMAGES_DIR=images
IMAGES_BASE_URL=/images
ASSETS_BASE_URL=/assets

# Upload
UPLOAD_MAX_FILE_SIZE=1000000
